{
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>"
    }
  },
  "Resources": {
    "PowerSwitchFunction63B1A828": {
      "DependsOn": [
        "PowerSwitchLogGroup6E87329A",
        "PowerSwitchPolicyBC388615",
        "PowerSwitchRole44FDDDDA"
      ],
      "Properties": {
        "Architectures": [
          "arm64"
        ],
        "Code": {
          "S3Bucket": {
            "Fn::Sub": "cdk-hnb659fds-assets-${AWS::AccountId}-${AWS::Region}"
          },
          "S3Key": "<asset-hash>.zip"
        },
        "Environment": {
          "Variables": {
            "ACCESS_AUD_PARAMETER": "/example/power/access_aud",
            "ACCESS_TEAM_DOMAIN_PARAMETER": "/example/edge/access_team_domain",
            "POWER_HOSTNAME": "power.example.com",
            "TAG_KEY": "power-switch"
          }
        },
        "FunctionName": "example-power-switch",
        "Handler": "index.handler",
        "MemorySize": 128,
        "ReservedConcurrentExecutions": 2,
        "Role": {
          "Fn::GetAtt": [
            "PowerSwitchRole44FDDDDA",
            "Arn"
          ]
        },
        "Runtime": "nodejs22.x",
        "Timeout": 15
      },
      "Type": "AWS::Lambda::Function"
    },
    "PowerSwitchFunctionFunctionUrlD89A24E3": {
      "DependsOn": [
        "PowerSwitchLogGroup6E87329A",
        "PowerSwitchPolicyBC388615"
      ],
      "Properties": {
        "AuthType": "NONE",
        "TargetFunctionArn": {
          "Fn::GetAtt": [
            "PowerSwitchFunction63B1A828",
            "Arn"
          ]
        }
      },
      "Type": "AWS::Lambda::Url"
    },
    "PowerSwitchFunctionUrlParameterDB2E0FCD": {
      "Properties": {
        "Name": "/example/power/function_url",
        "Type": "String",
        "Value": {
          "Fn::GetAtt": [
            "PowerSwitchFunctionFunctionUrlD89A24E3",
            "FunctionUrl"
          ]
        }
      },
      "Type": "AWS::SSM::Parameter"
    },
    "PowerSwitchFunctioninvokefunction8A7E92D1": {
      "DependsOn": [
        "PowerSwitchLogGroup6E87329A",
        "PowerSwitchPolicyBC388615"
      ],
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Fn::GetAtt": [
            "PowerSwitchFunction63B1A828",
            "Arn"
          ]
        },
        "InvokedViaFunctionUrl": true,
        "Principal": "*"
      },
      "Type": "AWS::Lambda::Permission"
    },
    "PowerSwitchFunctioninvokefunctionurlB7C59121": {
      "DependsOn": [
        "PowerSwitchLogGroup6E87329A",
        "PowerSwitchPolicyBC388615"
      ],
      "Properties": {
        "Action": "lambda:InvokeFunctionUrl",
        "FunctionName": {
          "Fn::GetAtt": [
            "PowerSwitchFunction63B1A828",
            "Arn"
          ]
        },
        "FunctionUrlAuthType": "NONE",
        "Principal": "*"
      },
      "Type": "AWS::Lambda::Permission"
    },
    "PowerSwitchLogGroup6E87329A": {
      "Properties": {
        "LogGroupName": "/aws/lambda/example-power-switch",
        "RetentionInDays": 14
      },
      "Type": "AWS::Logs::LogGroup"
    },
    "PowerSwitchPolicyBC388615": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": [
                "ec2:DescribeInstances",
                "rds:DescribeDBInstances",
                "rds:DescribeEvents"
              ],
              "Effect": "Allow",
              "Resource": "*",
              "Sid": "Describe"
            },
            {
              "Action": [
                "ec2:StartInstances",
                "ec2:StopInstances"
              ],
              "Condition": {
                "Null": {
                  "aws:ResourceTag/power-switch": "false"
                }
              },
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:",
                    {
                      "Ref": "AWS::Partition"
                    },
                    ":ec2:",
                    {
                      "Ref": "AWS::Region"
                    },
                    ":",
                    {
                      "Ref": "AWS::AccountId"
                    },
                    ":instance/*"
                  ]
                ]
              },
              "Sid": "SwitchTaggedInstances"
            },
            {
              "Action": [
                "rds:StartDBInstance",
                "rds:StopDBInstance"
              ],
              "Condition": {
                "Null": {
                  "rds:db-tag/power-switch": "false"
                }
              },
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:",
                    {
                      "Ref": "AWS::Partition"
                    },
                    ":rds:",
                    {
                      "Ref": "AWS::Region"
                    },
                    ":",
                    {
                      "Ref": "AWS::AccountId"
                    },
                    ":db:*"
                  ]
                ]
              },
              "Sid": "SwitchTaggedDatabases"
            },
            {
              "Action": "ssm:GetParameter",
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition"
                      },
                      ":ssm:",
                      {
                        "Ref": "AWS::Region"
                      },
                      ":",
                      {
                        "Ref": "AWS::AccountId"
                      },
                      ":parameter/example/edge/access_team_domain"
                    ]
                  ]
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition"
                      },
                      ":ssm:",
                      {
                        "Ref": "AWS::Region"
                      },
                      ":",
                      {
                        "Ref": "AWS::AccountId"
                      },
                      ":parameter/example/power/access_aud"
                    ]
                  ]
                }
              ],
              "Sid": "ReadSettings"
            },
            {
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    {
                      "Fn::GetAtt": [
                        "PowerSwitchLogGroup6E87329A",
                        "Arn"
                      ]
                    },
                    ":*"
                  ]
                ]
              },
              "Sid": "OwnLogs"
            }
          ],
          "Version": "2012-10-17"
        },
        "PolicyName": "example-power-switch",
        "Roles": [
          {
            "Ref": "PowerSwitchRole44FDDDDA"
          }
        ]
      },
      "Type": "AWS::IAM::Policy"
    },
    "PowerSwitchRole44FDDDDA": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "RoleName": "example-power-switch"
      },
      "Type": "AWS::IAM::Role"
    }
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5"
                  ],
                  {
                    "Ref": "BootstrapVersion"
                  }
                ]
              }
            ]
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI."
        }
      ]
    }
  }
}
